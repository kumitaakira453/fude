{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "mdglow: ローカル Markdown 閲覧に必要な権限",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "dialog:default",
    "fs:allow-read-text-file",
    "fs:allow-read-file",
    "fs:allow-read-dir",
    "fs:allow-stat",
    "fs:allow-exists",
    "fs:allow-watch",
    "fs:allow-unwatch",
    {
      "identifier": "fs:scope",
      "allow": ["$HOME/**"]
    }
  ]
}
