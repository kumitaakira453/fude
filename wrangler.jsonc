{
  // Cloudflare Workers 設定。静的アセット(dist)を配信しつつ、
  // run_worker_first で全リクエストを worker/index.ts の Basic 認証ゲートに通す。
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mdglow",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // ハッシュルーティングのため未知パスは index.html を返す
    "not_found_handling": "single-page-application",
    // 全リクエストを先に Worker（認証ゲート）へ通す
    "run_worker_first": true
  },
  "observability": {
    "enabled": true
  }
}
