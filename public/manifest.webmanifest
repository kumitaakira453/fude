{
  "name": "mdglow — Markdown Viewer",
  "short_name": "mdglow",
  "description": "ローカルの Markdown を、美しく読む。数式・コード・図・全文検索・リアルタイム反映。",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#0e1116",
  "theme_color": "#0e1116",
  "icons": [
    { "src": "/favicon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" },
    { "src": "/icon-maskable.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "maskable" }
  ]
}
